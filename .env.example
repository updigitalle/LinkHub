# Copie este arquivo para .env.local e preencha com os dados reais.
# NUNCA suba o .env.local para o GitHub.

# Nome exibido no site
NEXT_PUBLIC_APP_NAME="LinkHub"

# URL publica do site (dominio real, sem barra no final).
# OBRIGATORIA em producao (Hostinger): sem ela, o encurtador monta a URL
# curta usando o Host que o proxy da Hostinger envia, que costuma ser o
# endereco interno do app (ex: 0.0.0.0:3000) em vez do dominio real.
NEXT_PUBLIC_APP_URL="https://seudominio.com"

# Supabase (https://supabase.com)
# SUPABASE_URL e SUPABASE_ANON_KEY estao em: Dashboard > Settings > API
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_ANON_KEY="sua-anon-key-aqui"